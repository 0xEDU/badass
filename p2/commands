# Router 1 setup vxlan
ip link add vxlan10 type vxlan id 10 remote 10.0.0.2 dstport 4789 dev eth1 \
&& ip addr add 172.16.10.1/24 dev vxlan10 \
&& ip link set vxlan10 up

# Router 1 assign IP
ip addr add 30.1.1.3/24 dev eth1 \
&& ip link set eth1 up

# Router 1 setup bridge
ip link add br0 type bridge \
&& ip link set eth0 master br0 \
&& ip link set vxlan10 master br0 \
ip link set br0 up

# Router 2 setup vxlan
ip link add vxlan10 type vxlan id 10 remote 10.0.0.1 dstport 4789 dev eth1 \
&& ip addr add 172.16.10.2/24 dev vxlan10 \
&& ip link set vxlan10 up

# Router 2 assign IP
ip addr add 30.1.1.4/24 dev eth1 \
&& ip link set eth1 up

# Router 2 setup bridge
ip link add br0 type bridge \
&& ip link set eth0 master br0 \
&& ip link set vxlan10 master br0 \
&& ip link set br0 up

# Host 1 assign IP
ip addr add 30.1.1.1/24 dev eth0 \
&& ip link set eth0 up \
&& ip route add default via 30.1.1.3

# Host 2 assign IP
ip addr add 30.1.1.2/24 dev eth0 \
&& ip link set eth0 up \
&& ip route add default via 30.1.1.4

